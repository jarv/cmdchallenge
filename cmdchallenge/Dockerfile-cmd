# syntax = docker/dockerfile:1-experimental
# vi: ft=dockerfile
ARG BUILD_PLATFORM
FROM golang:1.26 as builder
# linux/amd64,linux/arm64
ARG BUILD_PLATFORM
RUN echo "${BUILD_PLATFORM}" | sed 's|linux/||' > /tmp/goarch
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 GOARCH=$(cat /tmp/goarch) GOOS=linux go build -ldflags "-w" -o oops ./cmd/oops/oops.go
RUN --mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 GOARCH=$(cat /tmp/goarch) GOOS=linux go build -ldflags "-w" -o serve ./cmd/runcmd/runcmd.go

FROM --platform=${BUILD_PLATFORM} ubuntu:22.04
# linux/amd64,linux/arm64
COPY --from=builder /app/serve /usr/local/bin/runcmd
COPY --from=builder /app/oops /usr/local/bin/oops-this-will-delete-bin-dirs

# Keep Ubuntu's other minimization rules, but restore manuals for base packages
# as well as utilities installed below. Installing man-db alone leaves a stub.
RUN sed -i '\|^path-exclude=/usr/share/man/\*|d' /etc/dpkg/dpkg.cfg.d/excludes && \
      rm -f /usr/bin/man && \
      dpkg-divert --quiet --remove --rename /usr/bin/man && \
      apt-get update && \
      dpkg-query -S /usr/share/man/ | \
        sed 's/: \/usr\/share\/man.*//' | tr ',' '\n' | sort -u | \
        xargs apt-get install -y --no-install-recommends --reinstall && \
      apt-get install -y jq bc rename bsdmainutils man file && \
      rm -rf /var/lib/apt/lists/* && \
      rm -f /etc/bash.bashrc && rm -rf /etc/bash_completion.d && \
      rm -f /root/.bashrc
ADD var/ /var/
